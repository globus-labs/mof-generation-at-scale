# Standalone examples: only sample inputs, runners, and usage are shared.
# Ignore all generated outputs, saved result reports, and replay collections.
/cp2k-test/*
!/cp2k-test/README.md
!/cp2k-test/cp2k.inp
!/cp2k-test/diagnose.py
!/cp2k-test/run-diagnostic-polaris.sh
!/cp2k-test/run-polaris.sh
!/cp2k-test/run-polaris-2node.sh
